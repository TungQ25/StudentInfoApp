<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/taskDetailOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/taskDetailScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#D9000000"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/detailScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_task_detail_dialog"
        android:clipToPadding="false"
        android:elevation="56dp"
        android:fillViewport="true"
        android:focusable="true"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.58"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1">

        <LinearLayout
            android:id="@+id/taskDetailContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="520dp"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/detailTopBar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageButton
                    android:id="@+id/btnDetailBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:alpha="0"
                    android:background="@drawable/bg_task_editor_icon_button"
                    android:clickable="false"
                    android:contentDescription="@string/task_editor_back"
                    android:focusable="false"
                    android:padding="10dp"
                    android:scaleX="0.84"
                    android:scaleY="0.84"
                    android:src="@drawable/ic_arrow_back"
                    android:translationX="-10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#D7DDE5" />

                <LinearLayout
                    android:id="@+id/detailCategoryPicker"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tvDetailPriority"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/tvDetailCategoryIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/task_editor_category"
                        android:src="@drawable/ic_nav_task_outline"
                        app:tint="#D7DDE5" />

                    <TextView
                        android:id="@+id/tvDetailCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Inbox"
                        android:textColor="#F2F4F7"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@string/task_editor_change_category"
                        android:src="@drawable/ic_editor_chevron_down" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/tvDetailPriority"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_task_editor_chip"
                    android:clickable="true"
                    android:contentDescription="Priority"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="8dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_editor_flag"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnDetailMore"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#8F969E" />

                <ImageButton
                    android:id="@+id/btnDetailMore"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_task_editor_icon_button"
                    android:contentDescription="@string/toolbar_more_options"
                    android:padding="10dp"
                    android:src="@drawable/ic_more_horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#9AA2AD" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/detailBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:id="@+id/detailCompletionRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/checkDetailComplete"
                        style="@style/Widget.TaskManager.CompleteCheckBox"
                        android:clickable="false"
                        android:focusable="false" />

                    <TextView
                        android:id="@+id/tvDetailDeadline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:textColor="#8F969E"
                        android:textSize="20sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/detailEditorContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDetailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_task_editor_card"
                        android:minHeight="58dp"
                        android:paddingStart="16dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp"
                        android:textColor="#F2F4F7"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvDetailDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_task_editor_card"
                        android:gravity="top|start"
                        android:lineSpacingExtra="4dp"
                        android:minHeight="122dp"
                        android:paddingStart="16dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp"
                        android:textColor="#D7DDE5"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:id="@+id/detailSubtasksPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_task_editor_card"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/task_editor_subtasks"
                            android:textColor="#BFC7D1"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/detailAddSubtaskRow"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="6dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@string/task_editor_add_subtask"
                                android:src="@drawable/ic_editor_plus_circle" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="@string/task_editor_add_subtask"
                                android:textColor="#27BDB7"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivDetailAttachment"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_task_editor_card"
                        android:contentDescription="@string/task_attachment_label"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
