<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:clickable="true"
    android:focusable="true"
    tools:context=".ui.fragment.SettingsFragment">

    <View
        android:id="@+id/settingsScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/settingsPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBackground"
        android:clipToOutline="true"
        android:elevation="56dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/settingsTopBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="20dp"
            android:paddingEnd="14dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnSettingsBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_task_editor_icon_button"
                android:contentDescription="@string/task_editor_back"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#D7DDE5" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/title_settings"
                android:textColor="@color/colorOnSurface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="40dp"
                android:layout_height="40dp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/settingsBody"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/settingsScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/settingsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="118dp">

                    <LinearLayout
                        android:id="@+id/settingsProfileCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_settings_card"
                        android:clipToOutline="true"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/settingsProfileRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="88dp"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingTop="14dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="14dp">

                            <TextView
                                android:id="@+id/tvSettingsAvatar"
                                android:layout_width="54dp"
                                android:layout_height="54dp"
                                android:background="@drawable/bg_settings_avatar"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:textColor="@color/colorAddAction"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                tools:text="TM" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvSettingsName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:textColor="@color/colorOnSurface"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    tools:text="User" />

                                <TextView
                                    android:id="@+id/tvSettingsEmail"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:ellipsize="end"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:textColor="@color/colorOnSurfaceVariant"
                                    android:textSize="13sp"
                                    tools:text="user@example.com" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:paddingStart="10dp"
                                android:text="&gt;"
                                android:textColor="@color/colorOnSurfaceVariant"
                                android:textSize="20sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="18dp" />

                    <LinearLayout
                        android:id="@+id/settingsAppearanceCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_settings_card"
                        android:clipToOutline="true"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/settingsAppearanceRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="58dp"
                            android:orientation="horizontal"
                            android:paddingStart="18dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="12dp">

                            <TextView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginEnd="14dp"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:text="&#x1F3A8;"
                                android:textColor="@color/colorAddAction"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:includeFontPadding="false"
                                android:text="Appearance"
                                android:textColor="@color/colorOnSurface"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/tvSettingsThemeValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="0.7"
                                android:ellipsize="end"
                                android:gravity="end"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="@color/colorOnSurfaceVariant"
                                android:textSize="14sp"
                                tools:text="System" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:paddingStart="10dp"
                                android:text="&gt;"
                                android:textColor="@color/colorOnSurfaceVariant"
                                android:textSize="20sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/colorDivider" />

                        <LinearLayout
                            android:id="@+id/settingsNotificationRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="58dp"
                            android:orientation="horizontal"
                            android:paddingStart="18dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="12dp">

                            <TextView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginEnd="14dp"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:text="&#x1F514;"
                                android:textColor="@color/colorAddAction"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:includeFontPadding="false"
                                android:text="Notifications"
                                android:textColor="@color/colorOnSurface"
                                android:textSize="16sp" />

                            <Switch
                                android:id="@+id/switchSettingsNotifications"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="16dp" />

                    <LinearLayout
                        android:id="@+id/settingsGeneralCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_settings_card"
                        android:clipToOutline="true"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/settingsDateTimeRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="58dp"
                            android:orientation="horizontal"
                            android:paddingStart="18dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="12dp">

                            <TextView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginEnd="14dp"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:text="&#x1F552;"
                                android:textColor="@color/colorAddAction"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:includeFontPadding="false"
                                android:text="Date &amp; Time"
                                android:textColor="@color/colorOnSurface"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:paddingStart="10dp"
                                android:text="&gt;"
                                android:textColor="@color/colorOnSurfaceVariant"
                                android:textSize="20sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/colorDivider" />

                        <LinearLayout
                            android:id="@+id/settingsGeneralRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="58dp"
                            android:orientation="horizontal"
                            android:paddingStart="18dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="12dp">

                            <TextView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginEnd="14dp"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:text="&#x2699;&#xFE0F;"
                                android:textColor="@color/colorAddAction"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:includeFontPadding="false"
                                android:text="General"
                                android:textColor="@color/colorOnSurface"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:paddingStart="10dp"
                                android:text="&gt;"
                                android:textColor="@color/colorOnSurfaceVariant"
                                android:textSize="20sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="16dp" />

                    <LinearLayout
                        android:id="@+id/settingsAboutCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_settings_card"
                        android:clipToOutline="true"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/settingsAboutRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="58dp"
                            android:orientation="horizontal"
                            android:paddingStart="18dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="12dp">

                            <TextView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginEnd="14dp"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:text="&#x2139;&#xFE0F;"
                                android:textColor="@color/colorAddAction"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:includeFontPadding="false"
                                android:text="About"
                                android:textColor="@color/colorOnSurface"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="0.7"
                                android:ellipsize="end"
                                android:gravity="end"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="v1.0"
                                android:textColor="@color/colorOnSurfaceVariant"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:paddingStart="10dp"
                                android:text="&gt;"
                                android:textColor="@color/colorOnSurfaceVariant"
                                android:textSize="20sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <TextView
                android:id="@+id/btnSettingsSignOut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_settings_logout"
                android:gravity="center"
                android:minHeight="54dp"
                android:paddingStart="18dp"
                android:paddingTop="15dp"
                android:paddingEnd="18dp"
                android:paddingBottom="15dp"
                android:text="Sign Out"
                android:textColor="@color/colorDangerButtonText"
                android:textSize="16sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
